{
  "name": "zkcloudworker-tests",
  "version": "0.1.0",
  "author": "DFST",
  "type": "module",
  "scripts": {
    "test": "jest --module=nodenext",
    "tx": "jest zktx",
    "prisma:generate": "yarn prisma generate",
    "prisma:seed": "yarn prisma db seed",
    "prisma:migrate": "yarn prisma migrate dev --name v1",
    "prisma:studio": "yarn prisma studio",
    "prisma:push": "yarn prisma db push",
    "prisma:migrate:deploy": "yarn prisma migrate deploy"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.24",
    "jest": "^29.7.0",
    "prisma": "^6.8.2",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "yarn@4.9.2",
  "dependencies": {
    "@minatokens/storage": "^0.16.16",
    "@prisma/client": "^6.8.2",
    "@solana/web3.js": "^1.98.2",
    "axios": "^1.9.0",
    "jose": "^5.10.0",
    "js-sha256": "^0.11.1",
    "matrix-js-sdk": "^36.2.0",
    "mina-signer": "^3.0.7",
    "nanoid": "^5.1.5",
    "nats": "^2.29.3",
    "o1js": "2.5.0",
    "openai": "^6.42.0",
    "protobufjs": "^7.5.3",
    "puppeteer": "^24.9.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "rss-parser": "^3.13.0",
    "zkcloudworker": "^0.25.12"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "slowTestThreshold": 1500,
    "testTimeout": 10800000,
    "bail": true,
    "verbose": true,
    "roots": [
      "tests"
    ],
    "setupFilesAfterEnv": [
      "./jest-config.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    }
  }
}
